{
  "name": "pindownloader",
  "version": "1.0.0",
  "description": "Downloader de vídeos do Pinterest",
  "main": "main/main.js",

  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder"
  },

  "build": {
    "appId": "com.msimionatto.pindownloader",
    "productName": "PinDownloader",

    "directories": {
      "output": "release"
    },

    "files": [
      "**/*"
    ],

    "extraResources": [
      {
        "from": "tools",
        "to": "tools"
      }
    ],

    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },

  "dependencies": {
    "axios": "^1.16.1",
    "electron-updater": "^6.8.3",
    "fs-extra": "^11.3.5",
    "youtube-dl-exec": "^3.1.6"
  },

  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  }
}